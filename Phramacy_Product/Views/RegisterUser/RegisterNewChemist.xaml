<Page x:Class="Phramacy_Product.Views.RegisterUser.RegisterNewChemist"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterNewChemist">

    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="50">
            <TextBlock Text="Register as Chemist" 
                       FontSize="32" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,30" />
            <TextBlock Text="Pharmacy Name" Margin="0,0,0,5" />
            <TextBox x:Name="PharmacyNameTextBox" Padding="5" />

            <TextBlock Text="Pharmacist Name" Margin="0,0,0,5" />
            <TextBox x:Name="PharmacistNameTextBox" Padding="5" />

            <TextBlock Text="Mobile Number" Margin="0,15,0,5" />
            <TextBox x:Name="MobileNumberTextBox" Padding="5" />

            <TextBlock Text="Email" Margin="0,15,0,5" />
            <TextBox x:Name="EmailTextBox" Padding="5" />

            <TextBlock Text="Password" Margin="0,15,0,5" />
            <PasswordBox x:Name="PasswordBox" Padding="5" 
                         PasswordChanged="PasswordBox_PasswordChanged" />

            <TextBlock Text="Confirm Password" Margin="0,15,0,5" />
            <PasswordBox x:Name="ConfirmPasswordBox" Padding="5" 
                         PasswordChanged="ConfirmPasswordBox_PasswordChanged" />

            <TextBlock x:Name="PasswordMismatchMessage" 
                       Text="Passwords do not match." 
                       Foreground="Red" 
                       Margin="0,5,0,0" 
                       Visibility="Collapsed" />

            <Button x:Name="RegisterButton" 
                    Height="50" 
                    Content="Register" 
                    Margin="0,30,0,10" 
                    Padding="10" 
                    Background="#3f51b5" 
                    Foreground="White" 
                    Click="RegisterButton_Click" />

            <TextBlock HorizontalAlignment="Center">
                <Run Text="Already have an account?" />
                <Hyperlink Click="BackToLogin">
                    <Run Text="Back to Login"/>
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>