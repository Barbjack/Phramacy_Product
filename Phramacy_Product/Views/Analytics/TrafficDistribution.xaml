<UserControl x:Class="Phramacy_Product.Views.Analytics.TrafficDistribution"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Phramacy_Product.Views.Analytics"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border Margin="10" Padding="20" Background="White" CornerRadius="8"
            BorderBrush="#DDD" BorderThickness="1"
            materialDesign:ShadowAssist.ShadowDepth="Depth1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Organic vs Paid Search" FontSize="16" Foreground="#888" FontWeight="SemiBold"/>
                    <TextBlock Text="Traffic Distribution" FontSize="20" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <materialDesign:PackIcon Kind="ArrowUp" Foreground="Green" VerticalAlignment="Center" Margin="0,0,2,0"/>
                        <TextBlock Text="{Binding IncreaseValue, StringFormat={}{0:F2}%}" Foreground="Green" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Legend -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Ellipse Fill="#F44336" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Organic" Margin="8,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Ellipse Fill="#4CAF50" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Direct" Margin="8,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Ellipse Fill="#2196F3" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Paid" Margin="8,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Pie Chart Section -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="250" Height="250">
                    <!-- Background Circle -->
                    <Ellipse Canvas.Left="0" Canvas.Top="0" Width="250" Height="250" 
                             Fill="Transparent" Stroke="#E0E0E0" StrokeThickness="2"/>

                    <!-- Organic Segment (Red) - 50% -->
                    <Path Fill="#F44336" StrokeThickness="2" Stroke="White">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="125,125">
                                    <LineSegment Point="125,25"/>
                                    <ArcSegment Point="225,125" Size="100,100" SweepDirection="Clockwise" IsLargeArc="False"/>
                                    <LineSegment Point="125,125"/>
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                    <!-- Direct Segment (Green) - 20% -->
                    <Path Fill="#4CAF50" StrokeThickness="2" Stroke="White">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="125,125">
                                    <LineSegment Point="225,125"/>
                                    <ArcSegment Point="52.32,177.68" Size="100,100" SweepDirection="Clockwise" IsLargeArc="False"/>
                                    <LineSegment Point="125,125"/>
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>

                    <!-- Paid Segment (Blue) - 30% -->
                    <Path Fill="#2196F3" StrokeThickness="2" Stroke="White">
                        <Path.Data>
                            <PathGeometry>
                                <PathFigure StartPoint="125,125">
                                    <LineSegment Point="52.32,177.68"/>
                                    <ArcSegment Point="125,25" Size="100,100" SweepDirection="Clockwise" IsLargeArc="False"/>
                                    <LineSegment Point="125,125"/>
                                </PathFigure>
                            </PathGeometry>
                        </Path.Data>
                    </Path>

                    <!-- Center Circle (White) -->
                    <Ellipse Canvas.Left="75" Canvas.Top="75" Width="100" Height="100" Fill="White"/>

                    <!-- Percentage Labels -->
                    <TextBlock Canvas.Left="95" Canvas.Top="75" Text="{Binding OrganicPercentage, StringFormat={}{0}%}" 
                               FontWeight="Bold" FontSize="18" Foreground="#F44336" HorizontalAlignment="Center"/>

                    <TextBlock Canvas.Left="140" Canvas.Top="140" Text="{Binding DirectPercentage, StringFormat={}{0}%}" 
                               FontWeight="Bold" FontSize="14" Foreground="#4CAF50"/>

                    <TextBlock Canvas.Left="80" Canvas.Top="140" Text="{Binding PaidPercentage, StringFormat={}{0}%}" 
                               FontWeight="Bold" FontSize="14" Foreground="#2196F3"/>
                </Canvas>
            </Grid>
        </Grid>
    </Border>
</UserControl>