<UserControl x:Class="Phramacy_Product.Views.Analytics.GrossRevenue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Phramacy_Product.Views.Analytics"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="root">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="MetricValueStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="MetricLabelStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>
        <local:IndexToXConverter x:Key="IndexToXConverter"/>
        <local:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
        <local:PointCollectionConverter x:Key="PointCollectionConverter"/>
        <local:AxisPositionConverter x:Key="AxisPositionConverter"/>
        <local:YAxisLabelConverter x:Key="YAxisLabelConverter"/>
        <local:NanToHiddenConverter x:Key="NanToHiddenConverter"/>
       
    </UserControl.Resources>

    <Border Margin="10" Padding="20" Background="White" CornerRadius="8"
            BorderBrush="#DDD" BorderThickness="1"
            materialDesign:ShadowAssist.ShadowDepth="Depth1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Total Revenue" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalRevenueValue, StringFormat=₹{0:F2}}" Foreground="DarkBlue" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>

                <ComboBox Grid.Column="1" HorizontalAlignment="Right" VerticalContentAlignment="Center" 
                          ItemsSource="{Binding AvailableMonths}"
                          SelectedIndex="{Binding SelectedMonthIndex, Mode=TwoWay}"
                          materialDesign:HintAssist.Hint="Select Month"
                          Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                </ComboBox>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Payment in Cash" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CashRevenue, StringFormat=₹{0:F2}}" Foreground="DarkBlue" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Payment Online" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OnlineRevenue, StringFormat=₹{0:F2}}" Foreground="DarkBlue" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Sales over time" FontSize="16" FontWeight="Bold"/>

                <Viewbox Grid.Row="1" Stretch="UniformToFill" Margin="0,10,0,0">
                    <Canvas Width="400" Height="200">
                        <Line X1="30" Y1="180" X2="380" Y2="180" Stroke="#CCC" StrokeThickness="1"/>
                        <Line X1="30" Y1="20" X2="30" Y2="180" Stroke="#CCC" StrokeThickness="1"/>

                        <ItemsControl ItemsSource="{Binding SalesChartData, Converter={StaticResource YAxisLabelConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding Text}" FontSize="10" Foreground="#666" 
                                   Canvas.Left="5" 
                                   Canvas.Top="{Binding YPos, Converter={StaticResource AxisPositionConverter}, ConverterParameter=YLabelOffset}"/>

                                        <Line X1="30" X2="380" 
                              Stroke="#EEE" StrokeThickness="1" StrokeDashArray="2 2"
                              Visibility="{Binding Text, Converter={StaticResource ZeroToVisibilityConverter}}"
                              Canvas.Top="{Binding YPos, Converter={StaticResource AxisPositionConverter}, ConverterParameter=YLineOffset}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl x:Name="XAxisLabels" ItemsSource="{Binding SalesChartData}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock  FontSize="10" 
                       HorizontalAlignment="Center"

                       Canvas.Left="{Binding 
                                         RelativeSource={RelativeSource AncestorType=ItemsControl}, 
                                         Path=ItemContainerGenerator.Items.IndexOf(.), 
                                         Converter={StaticResource IndexToXConverter}
                                     }" Canvas.Top="185"

                       Visibility="{Binding RelativeSource={RelativeSource Self}, 
                                            Path=Canvas.Left, 
                                            Converter={StaticResource NanToHiddenConverter}}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Polyline Stroke="#7F94FF" StrokeThickness="2">
                            <Polyline.Points>
                                <Binding Path="SalesChartData" Converter="{StaticResource PointCollectionConverter}" ConverterParameter="CurrentMonth"/>
                            </Polyline.Points>
                        </Polyline>

                        <Polyline Stroke="#B7D9E7" StrokeThickness="2">
                            <Polyline.Points>
                                <Binding Path="SalesChartData" Converter="{StaticResource PointCollectionConverter}" ConverterParameter="PreviousMonth"/>
                            </Polyline.Points>
                        </Polyline>
                    </Canvas>
                </Viewbox>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <materialDesign:PackIcon Kind="Circle" Foreground="#7F94FF" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentMonthName}" Margin="5,0,20,0" VerticalAlignment="Center"/>

                <materialDesign:PackIcon Kind="Circle" Foreground="#B7D9E7" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PreviousMonthName}" Margin="5,0,20,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>