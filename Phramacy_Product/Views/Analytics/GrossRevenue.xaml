<UserControl x:Class="Phramacy_Product.Views.Analytics.GrossRevenue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Phramacy_Product.Views.Analytics"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="MetricValueStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="MetricLabelStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>
    </UserControl.Resources>

    <Border Margin="10" Padding="20" Background="White" CornerRadius="8"
            BorderBrush="#DDD" BorderThickness="1"
            materialDesign:ShadowAssist.ShadowDepth="Depth1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="Gross revenue" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding GrossRevenueValue, StringFormat=${0:F2}}" Foreground="DarkBlue" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>

                <ComboBox Grid.Column="1" HorizontalAlignment="Right" VerticalContentAlignment="Center" SelectedIndex="0"
              materialDesign:HintAssist.Hint="Select Month"
              Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                    <ComboBoxItem Content="Jan"/>
                    <ComboBoxItem Content="Feb"/>
                    <ComboBoxItem Content="Mar"/>
                </ComboBox>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,20">
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Point of sale" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PointOfSaleRevenue, StringFormat=${0:F2}}" Foreground="DarkBlue" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                        <materialDesign:PackIcon Kind="ArrowDown" Foreground="Red" VerticalAlignment="Center"/>
                        <TextBlock Text="13%" Foreground="Red" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Online Store" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OnlineStoreRevenue, StringFormat=${0:F2}}" Foreground="DarkBlue" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                        <materialDesign:PackIcon Kind="ArrowUp" Foreground="Green" VerticalAlignment="Center"/>
                        <TextBlock Text="178%" Foreground="Green" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Online Store" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding OtherOnlineStoreRevenue, StringFormat=${0:F2}}" Foreground="DarkBlue" 
                  HorizontalAlignment="Left" Grid.Column="1" VerticalAlignment="Center"/>
                    <TextBlock Text="—" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Sales over time" FontSize="16" FontWeight="Bold"/>

                <Viewbox Grid.Row="1" Stretch="UniformToFill" Margin="0,10,0,0">
                    <Canvas Width="400" Height="200">
                        <Line X1="30" Y1="180" X2="380" Y2="180" Stroke="#CCC" StrokeThickness="1"/>
                        <Line X1="30" Y1="20" X2="30" Y2="180" Stroke="#CCC" StrokeThickness="1"/>

                        <TextBlock Text="0" Canvas.Left="10" Canvas.Top="170" FontSize="10"/>
                        <TextBlock Text="30" Canvas.Left="10" Canvas.Top="140" FontSize="10"/>
                        <TextBlock Text="60" Canvas.Left="10" Canvas.Top="110" FontSize="10"/>
                        <TextBlock Text="90" Canvas.Left="10" Canvas.Top="80" FontSize="10"/>
                        <TextBlock Text="120" Canvas.Left="5" Canvas.Top="50" FontSize="10"/>
                        <TextBlock Text="150" Canvas.Left="5" Canvas.Top="20" FontSize="10"/>

                        <TextBlock Text="Jan 1" Canvas.Left="30" Canvas.Top="185" FontSize="10"/>
                        <TextBlock Text="Jan 7" Canvas.Left="85" Canvas.Top="185" FontSize="10"/>
                        <TextBlock Text="Jan 13" Canvas.Left="140" Canvas.Top="185" FontSize="10"/>
                        <TextBlock Text="Jan 19" Canvas.Left="195" Canvas.Top="185" FontSize="10"/>
                        <TextBlock Text="Jan 25" Canvas.Left="250" Canvas.Top="185" FontSize="10"/>
                        <TextBlock Text="Jan 31" Canvas.Left="305" Canvas.Top="185" FontSize="10"/>

                        <Polyline Stroke="#7F94FF" StrokeThickness="2">
                            <Polyline.Points>
                                <Point X="30" Y="120"/>
                                <Point X="90" Y="115"/>
                                <Point X="150" Y="100"/>
                                <Point X="210" Y="55"/>
                                <Point X="270" Y="150"/>
                                <Point X="330" Y="140"/>
                            </Polyline.Points>
                        </Polyline>
                        <Polyline Stroke="#B7D9E7" StrokeThickness="2">
                            <Polyline.Points>
                                <Point X="30" Y="140"/>
                                <Point X="90" Y="160"/>
                                <Point X="150" Y="120"/>
                                <Point X="210" Y="60"/>
                                <Point X="270" Y="120"/>
                                <Point X="330" Y="150"/>
                            </Polyline.Points>
                        </Polyline>
                    </Canvas>
                </Viewbox>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                <materialDesign:PackIcon Kind="Circle" Foreground="#7F94FF" VerticalAlignment="Center"/>
                <TextBlock Text="Jan" Margin="5,0,20,0" VerticalAlignment="Center"/>
                <materialDesign:PackIcon Kind="Circle" Foreground="#B7D9E7" VerticalAlignment="Center"/>
                <TextBlock Text="Dec" Margin="5,0,20,0" VerticalAlignment="Center"/>
                <TextBlock Text="View report >" Foreground="#555" TextDecorations="Underline" VerticalAlignment="Center" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>