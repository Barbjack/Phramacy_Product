<Page x:Class="Phramacy_Product.Views.Distributors.DistributorsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Phramacy_Product.Views.Distributors"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
      mc:Ignorable="d"
      Title="DistributorsPage">
    <Page.Resources>
        <Style x:Key="NoHoverFlatButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{Binding Background, RelativeSource={RelativeSource Self}}" />
            <Setter Property="materialDesign:ColorZoneAssist.Mode" Value="PrimaryLight" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BlueHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Page.Resources>
    <Grid Background="#F5F6F8">
        <Border Background="White"
                CornerRadius="8"
                Padding="20"
                Margin="10"
                Effect="{DynamicResource MaterialDesignElevation2}">

            <DockPanel LastChildFill="True">

                <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Truck" Width="28" Foreground="#2563EB" Height="28" VerticalAlignment="Center" Margin="20,0,5,0"/>
                        <TextBlock Text="Distributors" FontSize="28" FontWeight="SemiBold" Foreground="#1F2937" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="ActionPanel">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SearchButton" Width="40" Height="36" Margin="20,0,25,0" Style="{StaticResource MaterialDesignToolButton}" ToolTip="Search" Click="SearchButton_Click">
                                <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" />
                            </Button>
                            <TextBox x:Name="SearchBox" Width="200" Height="36" VerticalAlignment="Center" Visibility="Collapsed" Background="White" Foreground="Black" materialDesign:HintAssist.Hint="Search..." LostFocus="SearchBox_LostFocus" Margin="0,0,25,0" />
                        </StackPanel>

                        <Button Content="+ Add Distributor" Click="CreateNewDistributor_Click" Height="36" Padding="20,0" Background="#16A34A" Foreground="White" FontWeight="SemiBold" BorderThickness="1" Cursor="Hand" Margin="0,0,25,0" Style="{StaticResource NoHoverFlatButtonStyle}" />
                    </StackPanel>
                </Grid>
                <Border Background="White" CornerRadius="6" Padding="10" Margin="0" Effect="{DynamicResource MaterialDesignElevation1}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="DistributorDataGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                                  GridLinesVisibility="None" Margin="10" RowHeight="40" FontSize="14" ColumnHeaderHeight="40" ColumnHeaderStyle="{StaticResource BlueHeaderStyle}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Distributor ID" Binding="{Binding DistributorID}" Visibility="Collapsed"/>
                                <DataGridTextColumn Header="Distributor Name" Binding="{Binding DistributorName}" Width="*"/>
                                <DataGridTextColumn Header="Contact Number" Binding="{Binding ContactNumber}" Width="*"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
                                <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt, StringFormat='MM-dd-yyyy'}" Width="*"/>
                                <DataGridTextColumn Header="Modified At" Binding="{Binding ModifiedAt, StringFormat=d}" Width="*"/>
                                <DataGridTemplateColumn Header="Action" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Click="Edit_Click" ToolTip="Edit" Style="{StaticResource MaterialDesignToolButton}">
                                                    <materialDesign:PackIcon Kind="Pencil" Width="20" Height="20" Foreground="DodgerBlue"/>
                                                </Button>
                                                <Button Click="Delete_Click" ToolTip="Delete" Style="{StaticResource MaterialDesignToolButton}">
                                                    <materialDesign:PackIcon Kind="Delete" Width="20" Height="20" Foreground="Red"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,8,0,0" VerticalAlignment="Bottom">
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                                <Button Background="DarkBlue" Content="&lt;&lt;" Click="FirstPageClick" Margin="0,0,5,0"/>
                                <Button Background="DarkBlue" Content="&lt;" Click="PreviousPageClick" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBlock Text="/" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="5,0"/>
                                <Button Background="DarkBlue" Content=">" Click="NextPageClick" Margin="5,0,5,0"/>
                                <Button Background="DarkBlue" Content=">>" Click="LastPageClick"/>
                            </StackPanel>
                        </Grid>
                        <Rectangle Fill="#80000000" Visibility="{Binding Visibility, ElementName=EditPanel}" Panel.ZIndex="99"/>
                        <Border x:Name="EditPanel" Background="White" CornerRadius="8" Padding="20" Margin="40" Visibility="Collapsed" VerticalAlignment="Center"
                                HorizontalAlignment="Center" Width="400" Panel.ZIndex="100" Effect="{DynamicResource MaterialDesignElevation3}">
                            <StackPanel>
                                <TextBlock Text="Distributor Details" FontSize="20" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,10"/>

                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Distributor Name" VerticalAlignment="Center"/>
                                    <TextBox x:Name="editDistributorName" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Contact Number" VerticalAlignment="Center"/>
                                    <TextBox x:Name="editContactNumber" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Email" VerticalAlignment="Center"/>
                                    <TextBox x:Name="editEmail" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Address" VerticalAlignment="Center"/>
                                    <TextBox x:Name="editAddress" Grid.Column="1"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Created At" VerticalAlignment="Center"/>
                                    <TextBox x:Name="editCreatedAt" Grid.Column="1" IsReadOnly="True" Background="#F0F0F0"/>
                                </Grid>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Modified At" VerticalAlignment="Center"/>
                                    <TextBox x:Name="editModifiedAt" Grid.Column="1" IsReadOnly="True" Background="#F0F0F0"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
                                    <Button Content="Update" Width="100" Click="SaveEdit_Click" Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
                                    <Button Content="Cancel" Width="100" Click="CancelEdit_Click" Style="{StaticResource MaterialDesignFlatButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Page>