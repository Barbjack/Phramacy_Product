<Page x:Class="Phramacy_Product.Views.Payment.PaymentDetail"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Phramacy_Product.Views.Payment"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:globalization="clr-namespace:System.Globalization;assembly=mscorlib"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PaymentDetail"
      Background="{DynamicResource MaterialDesignPaper}">

    <Page.Resources>
        <Style x:Key="WhiteHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="DarkBlue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        
    </Page.Resources>

    <Grid>
        <materialDesign:Card Padding="16" materialDesign:ShadowAssist.ShadowDepth="Depth2" Margin="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CashMultiple" Foreground="DarkBlue" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Sale Payment Details" FontWeight="Bold" Foreground="DarkBlue" FontSize="24" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,0,0,0">
                        <materialDesign:PackIcon Kind="Magnify" Width="30" Height="30" Margin="0,10"/>
                        <TextBox x:Name="SearchBox" 
                                 materialDesign:HintAssist.Hint="Search by Bill Number..."
                                 Width="200" 
                                 Height="36" 
                                 VerticalAlignment="Center">
                       
                       </TextBox>
                        
                        <ComboBox materialDesign:HintAssist.Hint="Select Time Period"
                            Width="150"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            SelectedItem="{Binding SelectedTimePeriod}"
                            SelectionChanged="ComboBox_SelectionChanged">
                            <ComboBoxItem Content="All Time"/>
                            <ComboBoxItem Content="This Month"/>
                            <ComboBoxItem Content="Last Month"/>
                            <ComboBoxItem Content="This Year"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Total Revenue (" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedTimePeriod}" FontSize="14" FontStyle="Italic" VerticalAlignment="Center"/>
                        <TextBlock Text="): " FontSize="14" VerticalAlignment="Center"/>

                        <TextBlock Text="{Binding TotalRevenue, StringFormat=C, ConverterCulture={x:Static globalization:CultureInfo.CurrentCulture}}" FontSize="16" FontWeight="Bold" Foreground="DarkBlue" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="PaymentDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserSortColumns="True"
                          Height="auto"
                          ItemsSource="{Binding DisplayedPayment}"
                          
                          ColumnHeaderStyle="{StaticResource WhiteHeaderStyle}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Customer Name" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="Patient Name" Binding="{Binding PatientName}" Width="*"/>
                        <DataGridTextColumn Header="Bill Number" Binding="{Binding BillNumber}" Width="*"/>
                        <DataGridTextColumn Header="Bill Date" Binding="{Binding BillDate, StringFormat={}{0:MM/dd/yyyy}}" Width="*"/>

                        <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat=C, ConverterCulture={x:Static globalization:CultureInfo.CurrentCulture}}" Width="*"/>

                        <DataGridTextColumn Header="Created By" Binding="{Binding CreatedBy}" Width="*"/>
                        <DataGridTextColumn Header="Payment Type" Binding="{Binding PaymentType}" Width="*"/>
                        <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt, StringFormat={}{0:MM/dd/yyyy}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
        <Grid VerticalAlignment="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Background="DarkBlue" Content="&lt;&lt;" Click="FirstPageClick" Margin="0,0,5,0"/>
                <Button Background="DarkBlue" Content="&lt;" Click="PreviousPageClick" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="5,0"/>
                <TextBlock Text="/" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="5,0"/>
                <Button Background="DarkBlue" Content=">" Click="NextPageClick" Margin="5,0,5,0"/>
                <Button Background="DarkBlue" Content=">>" Click="LastPageClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>