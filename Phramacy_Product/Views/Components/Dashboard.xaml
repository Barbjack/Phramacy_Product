<Window x:Class="Phramacy_Product.Views.Components.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Phramacy_Product.Views.Components"
        xmlns:cards="clr-namespace:Phramacy_Product.Views.Cards"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:components="clr-namespace:Phramacy_Product.Views.Components"
        mc:Ignorable="d"
        Title="Dashboard"
        Background="{DynamicResource MaterialDesignPaper}">
        
    <DockPanel>
        <components:Header DockPanel.Dock="Top"/> 
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="DashboardContent">
                <Grid Margin="10"
              HorizontalAlignment="Stretch" VerticalAlignment="Top">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <cards:SalesPurchaseCard Grid.Row="0" Grid.Column="0"/>
                    <cards:SalesMargin Grid.Row="0" Grid.Column="1"/>
                    <cards:SlowestSelling Grid.Row="0" Grid.Column="2"/>

                    <cards:CollectDueAmount Grid.Row="1" Grid.Column="0"/>
                    <cards:PayDueAmount Grid.Row="1" Grid.Column="1"/>
                    <cards:ExpiringItemCard Grid.Row="1" Grid.Column="2"/>

                    <cards:ShortBook Grid.Row="2" Grid.Column="0"/>
                    <cards:MonthlySaleGraph Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"/>

                </Grid>
            </ScrollViewer>
            <Frame x:Name="MainFrame"
           NavigationUIVisibility="Hidden"
           Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
