<UserControl x:Class="Phramacy_Product.Views.Cards.ShortBook"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Phramacy_Product.Views.Cards"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border Margin="10" Padding="10" Background="White" CornerRadius="8"
            BorderBrush="#DDD" BorderThickness="1"
            materialDesign:ShadowAssist.ShadowDepth="Depth1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style TargetType="Grid">
                    <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
                </Style>
            </Grid.Resources>

            <StackPanel Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="ShortBook" Foreground="DarkBlue" FontWeight="Bold" FontSize="16" Grid.Column="0"/>
                </Grid>

                <Grid Margin="0,10,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Medicine Name" FontWeight="SemiBold" FontSize="14" Grid.Column="0"/>
                    <TextBlock Text="CurrentStock" FontWeight="SemiBold" FontSize="14" Grid.Column="1"/>
                </Grid>
            </StackPanel>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding FilteredShortBookItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0">
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" SharedSizeGroup="DistributorCol"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto" SharedSizeGroup="AmountCol"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding itemName}" FontSize="14" Padding="0,2,0,0"
                                               Foreground="Blue" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock>
                                            <Run Foreground ="IndianRed" Text="Manufacturer:"/>
                                            <Run Text="{Binding manufacturer}" />
                                        </TextBlock>
                                        <TextBlock Text=" | "/>
                                        <TextBlock>
                                            <Run Foreground="IndianRed" Text="Priority:"/>
                                            <Run Text="{Binding priority}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding currentStock}" FontSize="14"
                                           Foreground="Black" HorizontalAlignment="Right" Padding="5,0"/>
                            </Grid>
                            <Border Height="1" Background="#EEE" Margin="0,4"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Background="DarkBlue" Content="&lt;&lt;" Click="FirstPageClick" Margin="0,0,5,0"/>
                <Button Background="DarkBlue" Content="&lt;" Click="PreviousPageClick" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="5,0"/>
                <TextBlock Text="/" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="5,0"/>
                <Button Background="DarkBlue" Content=">" Click="NextPageClick" Margin="5,0,5,0"/>
                <Button Background="DarkBlue" Content=">>" Click="LastPageClick"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>